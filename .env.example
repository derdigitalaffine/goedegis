GOEDEGIS_BIND_IP=0.0.0.0
GOEDEGIS_HTTP_PORT=8080
COMPOSE_PROFILES=core,database,jobs,tiles,geocoding,routing,ogc,monitoring
POSTGRES_DB=goedegis
POSTGRES_USER=goedegis
POSTGRES_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_PASSWORD
NOMINATIM_PASSWORD=CHANGE_ME_TO_DIFFERENT_LONG_RANDOM_PASSWORD
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_PASSWORD
OSM_PBF_URL=https://download.geofabrik.de/europe/germany/baden-wuerttemberg-latest.osm.pbf
OSM_REPLICATION_URL=https://download.geofabrik.de/europe/germany/baden-wuerttemberg-updates/
NOMINATIM_UPDATE_MODE=continuous
NOMINATIM_IMPORT_STYLE=full
NOMINATIM_THREADS=4
NOMINATIM_SHM_SIZE=2gb
VALHALLA_THREADS=4
VALHALLA_BUILD_ELEVATION=False
